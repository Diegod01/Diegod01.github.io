# LOO

COMPARACION DE LOS 4 MODELOS

```{r, fig.align='center'}
loo_modsj <- loo(modsj)
loo_modje <- loo(modje)
loo_modjp <- loo(modjp)
loo_modjs <- loo(modjs)

#comparacion
loo_compare(loo_modsj, loo_modje, loo_modjp, loo_modjs)

```
Resultado (demora mucho en ejecutarse):

Aviso: Found 4 observation(s) with a pareto_k > 0.7. We recommend calling 'loo' again with argument 'k_threshold = 0.7' in order to calculate the ELPD without the assumption that these observations are negligible. This will refit the model 4 times to compute the ELPDs for the problematic observations directly.
      elpd_diff se_diff
modje    0.0       0.0 
modjp -267.9      22.7 
modsj -451.7      26.1 
modjs -453.2      26.1 







Modelo de jerarquía por expedición es el mejor

# Posterior analisis

TIDY PARA MEJOR MODELO

```{r}
resumen_post <- tidy(modje, effects = "fixed", conf.int = TRUE, conf.level = 0.95) #el libro pone 80 pero lo hacemos con 95 que es el estandar (de intervalos de confianza)

resumen_post %>%
  select(term, estimate, std.error, conf.low, conf.high) %>%
  kable(digits = 3, caption = "Estimacion de efectos fijos ") %>%
  kable_styling()

#si conflow negativo y confhigh es positivo entonces 0 esta adentro, no es significativo
#si ambos son positivos aumenta la probabilidad de exito
#si ambos son negativos disminuye la probabilidad de exito
```

VER EFECTO QUE TUVO EL OXIGENO

```{r}

#hacemos un data frame donde cambiamos de 0 y 1 a true y false
newdata_oxy <- data.frame(
  oxygen_used = c(FALSE, TRUE),    
  season = c("Spring", "Spring"),  #season base
  year_since_first_ascent = 0,     #ano base
  expedition_id = "NewExp"        #id nueva
)

#orediccion de probabilidades posterioris
# allow.new.levels = TRUE permite usar "NewExp"
post_preds <- posterior_epred(modje, newdata = newdata_oxy, allow.new.levels = TRUE)

#organizacion de los datos en un data frame con sos columnas
#false viene a ser sin oxigeno (no utilizo)
#true viene a ser con oxigeno (si utilizo)
df_plot <- data.frame(
  NO = post_preds[,1],
  SI = post_preds[,2]
) %>% 
  pivot_longer(cols = everything(), names_to = "Escenario", values_to = "Probabilidad")

#grafica 
ggplot(df_plot, aes(x = Probabilidad, fill = Escenario)) +
  geom_density(alpha = 0.7) +
  scale_fill_manual(values = c("NO" = "#E74C3C", "SI" = "#2ECC71")) +
  labs(
    title = "Efecto del oxígeno en el éxito",
    x = "Probabilidad de éxito",
    y = "Densidad",
    fill = "Uso de óxígeno"
  ) +
  theme_minimal() +
  theme(legend.position = "top")
```

MOSTRAR QUE FUE UTIL HACER JERARQUIA POR EXPEDICION

caterpillar plot. muestra los efectos aleatorios (beta0j) del modelo muestra cada expedición y como le fue comparando con el promedio general (intercepto, "punto de partida") existe heterogeneidad entre grupos

```{r}
#Extraemos los efectos aleatorios (los interceptos de cada expedicion)
#ranef() nos da la desviación respecto al promedio global
random_effects <- ranef(modje)$expedition_id 
colnames(random_effects) <- "Intercepto_Desvio"

#muestra de 30 expediciones al azar
set.seed(123)
sample_expeditions <- random_effects %>%
  as.data.frame() %>%
  rownames_to_column("Expedition") %>%
  sample_n(30) %>%
  arrange(Intercepto_Desvio) #ordenado de peor a mejor

#caterpillar plot
ggplot(sample_expeditions, aes(x = Intercepto_Desvio, y = reorder(Expedition, Intercepto_Desvio))) +
  geom_point(size = 3, color = "#6584db") +
  geom_vline(xintercept = 0, color = "red") +
  labs(
    title = "Variabilidad entre expediciones para una muestra aleatoria de 30",
    x = "Diferencia respecto al promedio global (Log-Odds)",
    y = "Expedition ID"
  ) +
  theme_minimal() +
  theme(axis.text.y = element_text(size = 6)) # Texto pequeño para que quepan
```

COMO AFECTA EL OXIGENO A OTRA PREDICTORA: YEAR_SINCE_FIRST_ASCENT

```{r}

library(modelr)
#se crea un grid sin datos NA (faltantes) ya que este tipo de grafica no funciona si existen los mismos
#hacemos el grid data con lo que queremos comparar
grid_oxigeno <- climbers %>%
  data_grid(
    #eje x: diferencia entre el primer ascenso y el ultimo
    year_since_first_ascent = seq_range(year_since_first_ascent, n = 100),
    
    #vamos a comparar con uso o no de oxigeno
    oxygen_used = c(TRUE, FALSE), 
    
    #season spring de base
    season = "Spring",
    
    #fijar una expedicion promedio
    expedition_id = "Expedicion_Promedio" 
  )

#lineas predictivas (draws)
# re_formula = NA nos da el "promedio poblacional" (ignora la variabilidad de expediciones especificas)
plot_lines <- grid_oxigeno %>%
  add_fitted_draws(modje, n = 50, re_formula = NA) 

#grafica
ggplot(plot_lines, aes(x = year_since_first_ascent, y = .value, color = oxygen_used)) +
  #lineas representan incertidumbre del modelo
  geom_line(aes(group = paste(oxygen_used, .draw)), alpha = 0.2) +
  
  #linea de promedio
  stat_summary(fun = mean, geom = "line", aes(group = oxygen_used), size = 1.2) +
  
  scale_color_manual(values = c("FALSE" = "#E74C3C", "TRUE" = "#2ECC71"),
                     labels = c("No", "Sí")) +
  
  labs(
    title = "Como influye oxygen_used junto a year_since_first_ascent",
    x = "Años desde el primer ascenso",
    y = "Probabilidad de éxito",
    color = "Oxigeno"
  ) +
  theme_minimal() +
  theme(legend.position = "top")
```

No parece que year_since_first_ascent tenga efecto. oxigeno es lo que tiene mas efecto

vamos a comprobar la importancia de incluir el oxigeno ejecutando el modelo sin el mismo y comparando los loos

```{r, results='hide',include=FALSE, eval=FALSE}
options(mc.cores = parallel::detectCores())
modje_sin_oxi <- stan_glmer(
  success ~ season + year_since_first_ascent + (1 | expedition_id), 
  data = climbers, 
  family = binomial,
  prior_intercept = normal(0, 2.5, autoscale = TRUE),
  prior = normal(0, 2.5, autoscale = TRUE), 
  prior_covariance = decov(reg = 1, conc = 1, shape = 1, scale = 1),
  chains = 4, iter = 5000, seed = 84735
)


```

```{r, results='hide',eval=FALSE}
saveRDS(modje_sin_oxi, "modje_sin_oxi.rds")
```

```{r}
# 3. Comparamos la calidad predictiva (LOO) con el modelo completo
modje_sin_oxi <- readRDS("modje_sin_oxi.rds")
loo_con_oxi <- loo(modje)
loo_sin_oxi <- loo(modje_sin_oxi)

comparacion <- loo_compare(loo_con_oxi, loo_sin_oxi)
comparacion
```

# Tydi para el modelo sin oxigeno

```{r}
