ppcheck3
```

# Modelo 4

```{r, echo=TRUE, results='hide',eval=FALSE}
options(mc.cores = parallel::detectCores())
modjs <- stan_glmer(
  success ~  year_since_first_ascent + oxygen_used + (1 | season), 
  data = climbers, family = binomial,
  prior_intercept = normal(0, 2.5, autoscale = TRUE),
  prior = normal(0, 2.5, autoscale = TRUE), 
  prior_covariance = decov(reg = 1, conc = 1, shape = 1, scale = 1),
  chains = 4, iter = 5000*2, seed = 84735
)
```

```{r, results='hide',eval=FALSE}
saveRDS(modjs, "modjs.rds")
```

```{r}
modjs <- readRDS("modjs.rds")
ppcheck4 <- pp_check(modjs, nreps = 100, plotfun = "stat", stat = "success_rate") + 
  xlab("success rate")
ppcheck4
mcmc_trace(modjs)
```

# PP_Checks:

```{r}

p1 <- ppcheck1 + 
  labs(title = "Modelo 1", subtitle = "Complete Pooling") +
  theme(legend.position = "none") 

p2 <- ppcheck2 + 
  labs(title = "Modelo 2", subtitle = "Jerarquía por expedición") +
  theme(legend.position = "none")

p3 <- ppcheck3 + 
  labs(title = "Modelo 3", subtitle = "Jerarquía por peak") +
  theme(legend.position = "none")

p4 <- ppcheck4 + 
  labs(title = "Modelo 4", subtitle = "Jerarquía por season") +
  theme(legend.position = "none")

panel_ppcheck <- (p1 + p2) / (p3 + p4) +
  plot_annotation(
    title = "pp_check para los cuatro modelos",
  )

panel_ppcheck
```

Se observa de forma visual que no existen diferencias sustanciales entre los modelos. Se podría decir que en principio no aporta una mejoría realizar agrupamiento.

